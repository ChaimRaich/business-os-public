# Values for local development come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reading documents with Claude. Set ONE of the two options.
# Option A: Microsoft Foundry (Azure). EXTRACTION_MODEL is then the name of your deployment.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# Option B: Anthropic API.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
EXTRACTION_MODEL=
