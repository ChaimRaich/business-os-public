# Values for local development come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reading documents with an AI model. Set ONE of the three options.
# Option A: Claude on Microsoft Foundry (Azure). EXTRACTION_MODEL is then the name of your deployment.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# Option B: Claude on the Anthropic API.
ANTHROPIC_API_KEY=
# Option C: another image-reading model deployed in Azure AI Foundry (e.g. Kimi-K3.1-Pro).
# The endpoint is the Target URI from the deployment's page. EXTRACTION_MODEL is required: the deployment name.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
# Optional for Claude (defaults to claude-opus-5-5).
EXTRACTION_MODEL=

# Tests only: lets the web-store connection call a local stand-in server over http.
# Never set this in production; it disables the check that the store is a public https site.
# WOOCOMMERCE_ALLOW_LOCAL=1
